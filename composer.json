{
	"$schema": "https://getcomposer.org/schema.json",
	"name": "isudev/consent",
	"description": "Lightweight cookie consent banner with Google Consent Mode v2 and a consent log. No external scripts.",
	"type": "wordpress-plugin",
	"license": "GPL-3.0-or-later",
	"version": "1.2.0",
	"require": {
		"php": ">=8.2",
		"yahnis-elsts/plugin-update-checker": "^5.6"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/wordpress-stubs": "^7.1",
		"phpstan/phpstan": "^2.1",
		"szepeviktor/phpstan-wordpress": "^2.0.4",
		"wp-coding-standards/wpcs": "^3.4.1"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"extra": {
		"installer-name": "isudev-consent"
	},
	"scripts": {
		"check": ["@lint", "@analyse"],
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"analyse": "phpstan analyse --memory-limit=1G"
	}
}
